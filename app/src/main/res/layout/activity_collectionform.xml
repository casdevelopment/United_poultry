                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="20dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <LinearLayout
                            android:id="@+id/cashLayout"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:layout_weight="1"
                            android:elevation="2dp"
                            android:background="@drawable/rounded_bg"
                            android:gravity="center"
                            android:layout_marginEnd="10dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:layout_marginStart="2dp"
                            >

                            <ImageView
                                android:id="@+id/cashIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/cardclean"
                                android:contentDescription="icon" />


                            <TextView
                                android:id="@+id/cashText"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:text="Cash"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins"
                                android:textSize="10sp"
                                android:layout_marginLeft="5dp"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/addExpenseLayout"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:elevation="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_bg"
                            android:gravity="center"
                            android:layout_marginBottom="4dp"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:id="@+id/onlineIcon"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/download_icon"
                                android:contentDescription="icon" />


                            <TextView
                                android:id="@+id/onlineText"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:text="Online/Cheque"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins"
                                android:textSize="10sp"
                                android:layout_marginLeft="5dp"
                                android:layout_gravity="center"/>

                        </LinearLayout>


                    </LinearLayout>







                    <TextView
                        android:id="@+id/uploadTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Upload Payment Record"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="20dp"
                        android:layout_marginLeft="10dp"/>


                    <FrameLayout
                        android:id="@+id/imageContainer"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:background="@drawable/dashed_border"
                        android:padding="10dp"
                        android:layout_margin="10dp">

                        <!-- Image -->
                        <ImageView
                            android:id="@+id/selectedImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:visibility="gone"
                            android:scaleType="fitXY"
                            />

                        <!-- Placeholder text -->
                        <TextView
                            android:id="@+id/txtPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Click to Upload Image / File"
                            android:gravity="center"
                            android:textColor="@color/gray"
                            android:textStyle="bold"/>

                    </FrameLayout>


                    <TextView
                        android:id="@+id/imageError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/holo_red_dark"
                        android:textSize="12sp"
                        android:visibility="gone"
                        android:layout_marginBottom="7dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginLeft="10dp"/>


                    <androidx.cardview.widget.CardView
                        android:id="@+id/card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="2dp"
