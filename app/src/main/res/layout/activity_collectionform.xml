                                    android:layout_gravity="center"
                                    android:layout_marginRight="10dp"
                                    android:layout_marginLeft="10dp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins"
                                    android:text="Note (Optional)"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="10dp"/>

                            </LinearLayout>

                            <EditText

                                android:id="@+id/etPaymentNote"
                                android:hint="Any payment reference or notes..."
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="90dp"
                                android:gravity="top|start"
                                android:inputType="textMultiLine"
                                android:maxLines="3"
                                android:background="@drawable/edit_text_bg_black"
                                android:textColor="@color/black60"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginTop="10dp"
                                android:imeOptions="actionDone"
                                />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@android:color/holo_red_dark"
                                android:textSize="12sp"
                                android:visibility="gone"
                                android:layout_marginBottom="7dp"
                                android:layout_marginStart="10dp"/>


                        </LinearLayout>



                    </androidx.cardview.widget.CardView>



                </LinearLayout>





            </androidx.cardview.widget.CardView>







        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/note"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="40dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="20dp">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="Cancel"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/btn_light_bg"
                app:backgroundTint="@null"
                app:iconTint="@null"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                android:fontFamily="@font/poppins"
                android:layout_marginRight="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmCollection"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Confirm Collection"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/btn_continue_bg"
                app:backgroundTint="@null"
                android:fontFamily="@font/poppins"
                />





        </LinearLayout>


        </LinearLayout>






    </androidx.constraintlayout.widget.ConstraintLayout>


