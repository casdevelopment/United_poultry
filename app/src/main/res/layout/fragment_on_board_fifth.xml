<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/onboardingfive"
    tools:context=".Welcome.fragments.OnBoardFifthFragment">



    <!-- Title Text -->

    <!-- Description Text -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="50dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/fifth_title"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.386" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/fifth_t1"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:fontFamily="@font/poppins"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:gravity="center"/>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinueEmail"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/fifth_b1"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@drawable/btn_continue_bg"
        app:backgroundTint="@null"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintTop_toBottomOf="@id/tvDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/orContinue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/fifth_t2"
        android:textSize="15sp"
        android:textColor="@color/black"
        android:fontFamily="@font/poppins"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnContinueEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:gravity="center"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinueGoogle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/fifth_b2"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="@color/primary"
        android:background="@drawable/btn_light_bg"
        app:backgroundTint="@null"
        android:fontFamily="@font/poppins"
        android:textStyle="bold"

        app:icon="@drawable/googlevector"
        app:iconTint="@null"
        app:iconGravity="textStart"
        app:iconPadding="12dp"

        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintTop_toBottomOf="@id/orContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <TextView
        android:id="@+id/subdiscription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/fifth_t3"
        android:textSize="12sp"
        android:textColor="@color/blackLight"
        android:fontFamily="@font/poppins"
        app:layout_constraintTop_toBottomOf="@id/btnContinueGoogle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:gravity="center"/>

    <ImageView
        android:id="@+id/imgDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/dotsf2"
        android:contentDescription="Dots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/subdiscription"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginLeft="20dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:text="@string/fifth_b3"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@drawable/btn_continue_bg"
        app:backgroundTint="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/subdiscription"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginLeft="20dp"/>

    <!-- Arrow -->
    <ImageButton
        android:id="@+id/btnNext"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:background="@drawable/circle_white"
        android:src="@drawable/arrow5"
        android:contentDescription="Next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgDots"
        app:layout_constraintBottom_toBottomOf="@id/imgDots"
        android:layout_marginRight="20dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>
