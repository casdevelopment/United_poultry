                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="20dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <LinearLayout
                                android:id="@+id/cashLayout"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:orientation="horizontal"
                                android:padding="16dp"
                                android:layout_weight="1"
                                android:elevation="2dp"
                                android:background="@drawable/rounded_bg"
                                android:gravity="center"
                                android:layout_marginEnd="10dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="4dp"
                                android:layout_marginStart="2dp"
                                >

                                <ImageView
                                    android:id="@+id/cashIcon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/cardclean"
                                    android:contentDescription="icon" />


                                <TextView
                                    android:id="@+id/cashText"
                                    android:layout_height="wrap_content"
                                    android:layout_width="wrap_content"
                                    android:text="Cash"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/poppins"
                                    android:textSize="10sp"
                                    android:layout_marginLeft="5dp"/>

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/addExpenseLayout"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:orientation="horizontal"
                                android:padding="16dp"
                                android:elevation="2dp"
                                android:layout_weight="1"
                                android:background="@drawable/rounded_bg"
                                android:gravity="center"
                                android:layout_marginBottom="4dp"
                                android:layout_marginTop="4dp">

                                <ImageView
                                    android:id="@+id/onlineIcon"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:src="@drawable/download_icon"
                                    android:contentDescription="icon" />


                                <TextView
                                    android:id="@+id/onlineText"
                                    android:layout_height="wrap_content"
                                    android:layout_width="wrap_content"
                                    android:text="Online/Cheque"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/poppins"
                                    android:textSize="10sp"
                                    android:layout_marginLeft="5dp"
                                    android:layout_gravity="center"/>

                            </LinearLayout>


                        </LinearLayout>







                        <TextView
                            android:id="@+id/uploadTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:text="Upload Payment Record"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="20dp"
                            android:layout_marginLeft="10dp"/>


                        <FrameLayout
                            android:id="@+id/imageContainer"
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:background="@drawable/dashed_border"
                            android:padding="10dp"
                            android:layout_margin="10dp">


                            <!-- Image -->
                            <ImageView
                                android:id="@+id/selectedImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone"
                                android:scaleType="fitXY"
                                />

                            <TextView
                                android:id="@+id/txtPlaceholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="Click to Upload Image / File"
                                android:gravity="center"
                                android:textColor="@color/gray"
                                android:textStyle="bold"/>

                        </FrameLayout>


                        <TextView
                            android:id="@+id/imageError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/holo_red_dark"
                            android:textSize="12sp"
                            android:visibility="gone"
                            android:layout_marginBottom="7dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginLeft="10dp"/>


                        <androidx.cardview.widget.CardView
                            android:id="@+id/card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:backgroundTint="@color/white"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="10dp">


                                <!-- Text Container -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="25dp"
                                        android:layout_height="25dp"
                                        android:src="@drawable/notes_icon"
                                        app:tint="@color/primary"
                                        android:layout_gravity="center"
                                        android:layout_marginRight="10dp"
                                        android:layout_marginLeft="10dp"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/poppins"
                                        android:text="Note (Optional)"
                                        android:textColor="@color/black"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:layout_marginTop="10dp"/>

                                </LinearLayout>

                                <EditText
                                    android:id="@+id/etNote2"
                                    android:hint="Any payment reference or notes..."
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="90dp"
                                    android:gravity="top|start"
                                    android:inputType="textMultiLine"
                                    android:maxLines="3"
                                    android:background="@drawable/edit_text_bg_black"
                                    android:textColor="@color/black60"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="10dp"
                                    android:imeOptions="actionDone"
                                    />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@android:color/holo_red_dark"
                                    android:textSize="12sp"
                                    android:visibility="gone"
                                    android:layout_marginBottom="7dp"
                                    android:layout_marginStart="10dp"/>


                            </LinearLayout>



                        </androidx.cardview.widget.CardView>



                    </LinearLayout>





                </androidx.cardview.widget.CardView>



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/cardTotal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp">


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancel"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:text="Cancel"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:background="@drawable/btn_light_bg"
                        app:backgroundTint="@null"
                        android:layout_marginRight="10dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Submit Expense"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/btn_continue_bg"
                        app:backgroundTint="@null"
                        />





                </LinearLayout>





            </LinearLayout>




        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>