<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">


<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/riderdashboardonlinebackground">

    <!-- Top Image -->

    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.035"
        >

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="50dp"
            android:fontFamily="@font/quicksand"
            android:text="Hello, Ahmed!"
            android:textColor="@color/white"
            android:textSize="20sp"
            />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tuesday, 3 Dec 2025"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:layout_marginTop="5dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="50dp" />


    </LinearLayout>

        <ImageButton
            android:id="@+id/notifications"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/bell"
            android:contentDescription="icon"
            android:layout_marginRight="20dp"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            app:tint="@null"
            android:clickable="true"
            android:focusable="true"/>





    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="30dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topLayout">

        <androidx.cardview.widget.CardView
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <!-- Status Icon -->
                <ImageView
                    android:id="@+id/signalStatus"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/circle_white"
                    android:contentDescription="Status"
                    android:src="@drawable/offlinevector" />

                <!-- Text Container -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand"
                        android:text="You’re Offline"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatusSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Toggle to start receiving work"
                        android:textColor="@color/black"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/toggleStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:checked="false"
                    app:showText="false"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/switch_track_selector" />
            </LinearLayout>


        </androidx.cardview.widget.CardView>



        <androidx.cardview.widget.CardView
            android:id="@+id/todayTargetCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true"
            android:backgroundTint="@color/primary"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Top Row : Title + Completion -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Today’s Target"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:fontFamily="@font/quicksand"
                        android:textColor="@color/white"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/tvSaleDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="72% Complete"
                        android:fontFamily="@font/poppins"
                        android:textSize="12sp"
                        android:textColor="@color/white74"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/progressTodayTarget"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:progress="72"
                    android:max="100"
                    android:progressTint="@color/sub_primary"
                    android:backgroundTint="@color/primary20"
                    android:indeterminate="false"
                    android:clipToOutline="true"/>

                <!-- Bottom Row : Books + Amount -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- Total Books -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/shopVisited"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="28"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shops Visited"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:layout_gravity="center"/>
                    </LinearLayout>

                    <!-- Total Amount -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/targetShop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="40"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target Shops"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:layout_gravity="center"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/remainingShop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:layout_gravity="center"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Remaining"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:layout_gravity="center"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/todayTargetCardOffline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false"
            android:backgroundTint="@color/sub_primary18">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/circle_white"
                    android:contentDescription="Status"
                    android:src="@drawable/offlinecard2"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You’re Currently Offline"
                    android:fontFamily="@font/poppins"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toggle the switch above to go online and start your deliveries for today."
                    android:fontFamily="@font/poppins"
                    android:textSize="11sp"
                    android:textColor="@color/black"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center"
                    android:gravity="center" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvStatesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="50dp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:text="Yesterday’s Summary"
            android:textColor="@color/primary"
            android:textSize="22sp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary20"
                android:background="@drawable/rounded_bg"
                android:gravity="center"
                android:layout_marginEnd="20dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/totalsalesvector"
                    android:contentDescription="icon" />

                <TextView
                    android:id="@+id/tvTotalSales"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Rs 123456"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:textSize="18sp"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Total Sales"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:textSize="14sp"
                    android:textColor="@color/blackLight" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_weight="1"
                android:backgroundTint="@color/sub_primary18"
                android:background="@drawable/rounded_bg"
                android:gravity="center">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/collectedsalevector"
                    android:contentDescription="icon" />

                <TextView
                    android:id="@+id/tvCollectedSales"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Rs 123456"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:textSize="18sp"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Collected"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:textSize="14sp"
                    android:textColor="@color/blackLight" />

            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_weight="1"
                android:backgroundTint="@color/pink15"
                android:background="@drawable/rounded_bg"
                android:gravity="center"
                android:layout_marginEnd="20dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/boxsolidsalesvector"
                    android:contentDescription="icon" />

                <TextView
                    android:id="@+id/tvBoxSales"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="12"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:textSize="18sp"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Boxes Sold"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:textSize="14sp"
                    android:textColor="@color/blackLight" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_weight="1"
                android:backgroundTint="@color/green15"
                android:background="@drawable/rounded_bg"
                android:gravity="center">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/shopvisitedvector"
                    android:contentDescription="icon" />

                <TextView
                    android:id="@+id/tvShopvisited"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="34"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:textSize="18sp"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Shops Visited"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:textSize="14sp"
                    android:textColor="@color/blackLight" />

            </LinearLayout>

        </LinearLayout>



    </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="50dp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:text="Quick Actions"
            android:textColor="@color/primary"
            android:textSize="22sp" />



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="5dp"
        android:layout_marginBottom="30dp">

        <LinearLayout
            android:id="@+id/quickNewLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_bg"
            android:gravity="center"
            android:layout_marginEnd="5dp">

            <ImageView
                android:id="@+id/quickNewImage"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="icon" />


            <TextView
                android:layout_marginTop="5dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="New Sales"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textSize="10sp"
                android:textColor="@color/blackLight"
                android:layout_gravity="center"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/quickCollectLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_weight="1"

            android:background="@drawable/rounded_bg"
            android:gravity="center"
            android:layout_marginEnd="5dp">

            <ImageView
                android:id="@+id/quickCollectImage"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="icon" />


            <TextView
                android:layout_marginTop="5dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Collect"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textSize="10sp"
                android:textColor="@color/blackLight"
                android:layout_gravity="center"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/quickShopLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_bg"
            android:gravity="center"
            android:layout_marginEnd="5dp">

            <ImageView
                android:id="@+id/quickShopImage"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="icon" />


            <TextView
                android:layout_marginTop="5dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="My shops"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textSize="10sp"
                android:textColor="@color/blackLight"
                android:layout_gravity="center"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/quickHistoryLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_bg"
            android:gravity="center">

            <ImageView
                android:id="@+id/quickHistoryImage"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="icon" />


            <TextView
                android:layout_marginTop="5dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="History"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textSize="10sp"
                android:textColor="@color/blackLight"
                android:layout_gravity="center"/>

        </LinearLayout>

    </LinearLayout>





    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>