            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/edit_text_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/lockvectorfinal"
                    android:contentDescription="@null"/>

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/login_e2"
                    android:paddingStart="12dp"
                    android:background="@null"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins"
                    android:inputType="textPassword"/>

                <ImageView
                    android:id="@+id/imgTogglePassword"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/eyevectorfinal"
                    android:contentDescription="@null"
                    app:tint="@color/primary"/>
            </LinearLayout>

            <TextView
                android:id="@+id/etPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="7dp"
                android:layout_marginStart="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/edit_text_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/lockvectorfinal"
                    android:contentDescription="@null"/>

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/signup_e4"
                    android:paddingStart="12dp"
                    android:background="@null"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins"
                    android:inputType="textPassword"/>

                <ImageView
                    android:id="@+id/imgToggleConfirmPassword"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/eyevectorfinal"
                    android:contentDescription="@null"
                    app:tint="@color/primary"/>
            </LinearLayout>

            <TextView
                android:id="@+id/etConfirmPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="7dp"
                android:layout_marginStart="10dp"/>




        </LinearLayout>







