                            android:layout_marginEnd="10dp"
                            android:background="@drawable/square_white"
                            android:contentDescription="Status"
                            android:src="@drawable/nextarrowsvg"
                            android:layout_gravity="center_vertical"/>


                    </LinearLayout>


